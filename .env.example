# Local dependency defaults. The fake SDK mode needs no external account or API key.
POSTGRES_DB=sessions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
DATABASE_URL=postgres://postgres:dev@postgres:5432/sessions

AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=claude-sessions

GITEA_URL=http://gitea:3000
# api-key: workers reach the API listener through the proxy, and `none`
# would let them act as any owner via X-Owner-Id. Issue a key with
# `docker compose exec api bun run apps/api/src/keys.ts create <owner>`.
AUTH_MODE=api-key
FAKE_SDK=true

# Worker egress. The network must be the internal one compose creates, and
# the proxy is the only route off it. EGRESS_ALLOWLIST destinations must
# resolve to public addresses; EGRESS_PRIVATE_ALLOWLIST is for the ones
# deliberately inside the private plane. Link-local is refused in both.
EXECUTION_DOCKER_NETWORK=agent-platform-worker
EXECUTION_DOCKER_NETWORK_ALLOWLIST=agent-platform-worker
EXECUTION_EGRESS_PROXY_URL=http://egress-proxy:3128
EGRESS_ALLOWLIST=api.anthropic.com:443

# Compose `apps` profile (94S-125). The scheduler launches WORKER_IMAGE per
# session and hands it WORKER_GATEWAY_URL, which it reaches through the proxy.
# Two installations sharing one Docker daemon need distinct
# EXECUTION_INSTALLATION_ID, EXECUTION_DOCKER_NETWORK and proxy values.
WORKER_IMAGE=agent-platform-worker:dev
WORKER_GATEWAY_URL=http://api:3000
EXECUTION_INSTALLATION_ID=local
EXECUTION_SLOT_LIMIT=10
# Per-worker container limits the scheduler applies (apps/scheduler/src/config.ts).
WORKER_CPUS=1
WORKER_MEMORY_MB=2048
SCHEDULER_INTERVAL_SEC=5
SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
SCHEDULER_HEALTH_STALE_SEC=60
SCHEDULER_PASS_TIMEOUT_SEC=120
HEARTBEAT_TTL_SEC=30
# localstack:4566 is the worker's object store (S3_BUCKET above); the scheduler
# hands workers the same AWS_* values plus a per-session key prefix. api:3000 is
# the compose-run API the worker gateway lives on.
EGRESS_PRIVATE_ALLOWLIST=api:3000,host.docker.internal:3000,gitea:3000,localstack:4566
