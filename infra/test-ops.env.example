# The test-ops installation's settings (docs/test-ops.md). Install a copy
# outside the checkout, readable by the operator alone:
#
#   sudo install -m 600 -o "$USER" infra/test-ops.env.example /etc/agent-platform/test-ops.env
#
# scripts/test-ops.sh hands the file to compose with --env-file and never
# sources it; compose reads KEY=value lines. Every value compose.test-ops.yml
# requires is below and left empty, so a forgotten one stops compose. Use
# letters, digits and . _ ~ - only: the postgres values go into a URL
# unescaped, and the preflight refuses anything else there.
#
# The object store is chosen at deploy by TEST_OPS_OBJECT_STORE, not here:
# localstack (the default) needs nothing below; s3 needs the block at the end.

# Two installations on one daemon need different ids; `local` is the local stack's.
EXECUTION_INSTALLATION_ID=test-ops

POSTGRES_PASSWORD=
# The API and the egress proxy share it; 32 or more random characters.
EGRESS_AUTHORIZER_TOKEN=

# The operator's shared provider key, internal alpha only (94S-376). The
# catalog's profiles name it with `value_env: ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# The catalog directory (profiles.yaml, repositories.yaml), outside the
# checkout; the release manifest names its revision.
PLATFORM_CATALOG_DIR=/etc/agent-platform/catalog

# Credential routes: the provider, Gitea, and the object store — on
# localstack localstack:4566 here; on s3 the bucket's S3 host
# (<bucket>.s3.<region>.amazonaws.com:443) in the first list instead.
EGRESS_CREDENTIAL_ALLOWLIST=api.anthropic.com:443
EGRESS_CREDENTIAL_PRIVATE_ALLOWLIST=gitea:3000,localstack:4566

# Worker workspace quota on xfs with prjquota; the scheduler probes it at startup.
EXECUTION_WORKSPACE_QUOTA=on

# Installation limits and the rest of compose.core.yml's settings keep
# their defaults unless set here, e.g.:
# EXECUTION_SLOT_LIMIT=10
# SESSION_COST_LIMIT_USD=25

# TEST_OPS_OBJECT_STORE=s3 only: the bucket (Tokyo, versioning + Object Lock
# + SSE-S3) and the API's IAM key.
# AWS_REGION=ap-northeast-1
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
