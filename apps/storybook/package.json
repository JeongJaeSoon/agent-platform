{
  "name": "@agent-platform/storybook",
  "description": "Storybook for packages/ui: every component and screen state, light and dark, down to 390px",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir dist",
    "test:stories": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@agent-platform/client": "workspace:*",
    "@agent-platform/contracts": "workspace:*",
    "@agent-platform/core": "workspace:*",
    "@agent-platform/react": "workspace:*",
    "@agent-platform/ui": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
