#!/bin/sh
# Every client hook in the image's core.hooksPath is this one script
# (design github-agent.md decision 5). It runs the repository's own hook of
# the same name, then for prepare-commit-msg and commit-msg fixes the
# message's attribution (werft-trailers.sh). prepare-commit-msg is the one
# that still runs under `git commit --no-verify`.
name=$(basename "$0")
here=$(cd "${0%/*}" && pwd -P)

# The engine's git gets this directory as core.hooksPath on its command line
# level (gitEnvironment), which outranks a repository's own setting such as
# husky's. The setting git would use without that one (worktree, local,
# global or system config, ~ expanded) names the hooks to run instead of
# .git/hooks, as git itself would; relative, it is from the worktree's top.
hooks=$(GIT_CONFIG_COUNT=0 git config --type=path --get core.hooksPath 2>/dev/null)
case $hooks in
  "") ;;
  /*) ;;
  *) hooks=$(git rev-parse --show-toplevel 2>/dev/null || git rev-parse --absolute-git-dir)/$hooks ;;
esac
# Unset, or this directory (the image's system setting): the repository chose
# none, and its hooks are the default .git/hooks.
if [ -z "$hooks" ] || [ "$(cd "$hooks" 2>/dev/null && pwd -P)" = "$here" ]; then
  hooks=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/hooks
fi
own=$hooks/$name

case $name in
  prepare-commit-msg | commit-msg) ;;
  *)
    if [ -n "$own" ] && [ -x "$own" ]; then exec "$own" "$@"; fi
    exit 0
    ;;
esac

if [ -n "$own" ] && [ -x "$own" ]; then "$own" "$@" || exit $?; fi

[ -n "$1" ] || exit 0
. "$here/werft-trailers.sh"
werft_fix_message "$1"
