#!/bin/sh
# Remakes the session's own commits with the attribution the platform issued
# (design github-agent.md decision 5), using git plumbing only. No rebase,
# read-tree or merge: those rewrite pushed history, touch the working tree
# (and with it uncommitted changes), or lose a merge's parents.
#
#   werft-repair-attribution <repository> <protected-file>
#
# <protected-file> lists, one per line, commits that are never remade (the
# server's confirmed checkpoints). The boundary is those plus every
# remote-tracking ref; the range is what HEAD holds beyond it. Each range
# commit is remade in order with the same tree, the first parent mapped to its
# remade commit, the other parents as they were, and its message passed
# through the hook's own function (werft-trailers.sh). Author and committer
# are the claim's identity, stated on the command line so git's environment
# and config cannot change them.
#
# Nothing is written until the new tip is verified; then one update-ref that
# only applies if the ref still holds the old tip. The index and working tree
# are not touched: the tree is unchanged, so uncommitted changes stay the
# same changes.
#
# Prints one line and exits: 0 `clean` or `repaired <old> <new>`, 2
# `nested_merge <sha>` (a range merge has another range commit as a parent;
# nothing written), 1 anything else (nothing written).
set -u

fail() { printf 'failed: %s\n' "$1"; exit 1; }

repo=${1:?repository}
protected_file=${2:?protected file}
cd "$repo" || fail "no repository"

here=$(cd "${0%/*}" 2>/dev/null && pwd -P)
if [ -f "$here/werft-trailers.sh" ]; then
  trailers=$here/werft-trailers.sh
else
  trailers=/usr/local/share/werft/git-hooks/werft-trailers.sh
fi
[ -f "$trailers" ] || fail "no werft-trailers.sh"
# shellcheck disable=SC1090
. "$trailers"

# The identity is read from the system config (the image includes the claim's
# identity file there). The worker's own git runs with GIT_CONFIG_NOSYSTEM, so
# that is lifted for this process.
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL \
  GIT_AUTHOR_DATE GIT_COMMITTER_DATE GIT_CONFIG_NOSYSTEM GIT_CONFIG_COUNT \
  GIT_CONFIG_PARAMETERS
# The repository's config, the global config and the file the system config
# includes are all in the agent's reach. Config given through the environment
# outranks every file, so what could start a program is pinned here.
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_COUNT=8
GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null
GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false
GIT_CONFIG_KEY_2=log.showSignature GIT_CONFIG_VALUE_2=false
GIT_CONFIG_KEY_3=gpg.program GIT_CONFIG_VALUE_3=/bin/false
GIT_CONFIG_KEY_4=gpg.ssh.program GIT_CONFIG_VALUE_4=/bin/false
GIT_CONFIG_KEY_5=gpg.x509.program GIT_CONFIG_VALUE_5=/bin/false
GIT_CONFIG_KEY_6=core.pager GIT_CONFIG_VALUE_6=cat
GIT_CONFIG_KEY_7=gc.auto GIT_CONFIG_VALUE_7=0
export GIT_CONFIG_GLOBAL GIT_CONFIG_COUNT \
  GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1 \
  GIT_CONFIG_KEY_2 GIT_CONFIG_VALUE_2 GIT_CONFIG_KEY_3 GIT_CONFIG_VALUE_3 \
  GIT_CONFIG_KEY_4 GIT_CONFIG_VALUE_4 GIT_CONFIG_KEY_5 GIT_CONFIG_VALUE_5 \
  GIT_CONFIG_KEY_6 GIT_CONFIG_VALUE_6 GIT_CONFIG_KEY_7 GIT_CONFIG_VALUE_7
# A missing object must not start a fetch: a repository that names a promisor
# remote would run the program it configures (an upload-pack or ext:: command).
# GIT_NO_LAZY_FETCH is honoured from git 2.44; for older git the fetch it would
# start is a child git, which no transport is allowed to serve here.
GIT_NO_LAZY_FETCH=1
GIT_ALLOW_PROTOCOL=none
export GIT_NO_LAZY_FETCH GIT_ALLOW_PROTOCOL
# A local `git replace` must not change which tree, message or parents are read.
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS
git rev-parse -q --verify HEAD >/dev/null || { echo clean; exit 0; }

name=$(git config --system --includes --get user.name) || fail "no identity name"
email=$(git config --system --includes --get user.email) || fail "no identity email"
[ -n "$name" ] && [ -n "$email" ] || fail "empty identity"

work=$(mktemp -d "${TMPDIR:-/tmp}/werft-repair.XXXXXX") || fail "no temp directory"
trap 'rm -rf "${work:?}"' EXIT

# Protection: local remote-tracking refs and the server's commits. A commit the
# server named that this repository does not hold is skipped.
: >"$work/exclude"
git for-each-ref --format='%(objectname)' refs/remotes >>"$work/exclude"
if [ -f "$protected_file" ]; then
  while IFS= read -r sha || [ -n "$sha" ]; do
    case $sha in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
      *) continue ;;
    esac
    git cat-file -e "$sha^{commit}" 2>/dev/null && printf '%s\n' "$sha" >>"$work/exclude"
  done <"$protected_file"
fi
# shellcheck disable=SC2046
set -- $(sort -u "$work/exclude")
old_tip=$(git rev-parse HEAD)
if [ $# -gt 0 ]; then
  git rev-list --reverse --topo-order HEAD --not "$@" >"$work/range" || fail "rev-list"
else
  git rev-list --reverse --topo-order HEAD >"$work/range" || fail "rev-list"
fi
[ -s "$work/range" ] || { echo clean; exit 0; }
sort "$work/range" >"$work/range.sorted"

mkdir "$work/map" "$work/msg"
while IFS= read -r c; do
  # <commit> <parent>...
  line=$(git rev-list --parents -n 1 "$c") || fail "parents of $c"
  # shellcheck disable=SC2086
  set -- $line
  shift
  parent_args=""
  old_parents="$*"
  new_parents=""
  first=1
  for p in "$@"; do
    if [ -f "$work/map/$p" ]; then
      mapped=$(cat "$work/map/$p")
      if [ "$first" -eq 0 ] && [ "$mapped" != "$p" ]; then
        printf 'nested_merge %s\n' "$c"
        exit 2
      fi
    elif grep -qx "$p" "$work/range.sorted"; then
      # In range but not yet remade cannot happen in topological order.
      fail "parent $p of $c out of order"
    else
      mapped=$p
    fi
    parent_args="$parent_args -p $mapped"
    new_parents="$new_parents $mapped"
    first=0
  done
  new_parents=${new_parents# }

  git cat-file commit "$c" | awk 'f { print } /^$/ && !f { f = 1 }' >"$work/msg/$c" ||
    fail "message of $c"
  cp "$work/msg/$c" "$work/msg/$c.orig" || fail "message copy of $c"
  werft_fix_message "$work/msg/$c" || fail "message fix of $c"

  # A commit that already carries the issued attribution, on unchanged
  # parents, stays as it is: its hash and any signature survive. Blank lines
  # at the end of the message are not a difference (the function trims them;
  # $(...) drops them from both sides).
  if [ "$old_parents" = "$new_parents" ] &&
    [ "$(cat "$work/msg/$c")" = "$(cat "$work/msg/$c.orig")" ] &&
    [ "$(git log -1 --format='%an%n%ae%n%cn%n%ce' "$c")" = "$name
$email
$name
$email" ]; then
    printf '%s' "$c" >"$work/map/$c"
    continue
  fi

  tree=$(git rev-parse "$c^{tree}") || fail "tree of $c"
  author_date=$(git log -1 --format=%ad --date=raw "$c")
  committer_date=$(git log -1 --format=%cd --date=raw "$c")
  # shellcheck disable=SC2086
  new=$(GIT_AUTHOR_DATE=$author_date GIT_COMMITTER_DATE=$committer_date \
    git -c user.name="$name" -c user.email="$email" -c commit.gpgsign=false \
    commit-tree "$tree" $parent_args -F "$work/msg/$c") || fail "commit-tree of $c"
  printf '%s' "$new" >"$work/map/$c"

  # What the new commit must be, checked before anything is written.
  [ "$(git rev-parse "$new^{tree}")" = "$tree" ] || fail "tree changed at $c"
  [ "$(git rev-list --parents -n 1 "$new" | wc -w)" -eq "$(($# + 1))" ] ||
    fail "parent count changed at $c"
  [ "$(git log -1 --format='%an%n%ae%n%cn%n%ce' "$new")" = "$name
$email
$name
$email" ] || fail "identity not applied at $c"
done <"$work/range"

new_tip=$(cat "$work/map/$old_tip" 2>/dev/null) || fail "tip not remade"
if [ "$new_tip" = "$old_tip" ]; then echo clean; exit 0; fi
[ "$(git rev-parse "$new_tip^{tree}")" = "$(git rev-parse "$old_tip^{tree}")" ] ||
  fail "tip tree changed"

if branch=$(git symbolic-ref -q HEAD); then
  git -c core.hooksPath=/dev/null update-ref -m "werft-repair-attribution" "$branch" "$new_tip" "$old_tip" ||
    fail "the branch moved meanwhile"
else
  git -c core.hooksPath=/dev/null update-ref --no-deref -m "werft-repair-attribution" HEAD "$new_tip" "$old_tip" ||
    fail "HEAD moved meanwhile"
fi
printf 'repaired %s %s\n' "$old_tip" "$new_tip"
