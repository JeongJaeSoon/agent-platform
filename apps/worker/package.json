{
  "name": "@werft-ai/worker",
  "description": "Kiel session runtime: one container per session running the Claude Agent SDK",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "bun run src/main.ts",
    "test:unit": "bun test src --path-ignore-patterns='**/*.integration.test.ts' && bun run --cwd ../../packages/adapters/runtimes/claude test:unit",
    "test:direct-local": "bun test .integration.test.ts && bun run --cwd ../../packages/adapters/runtimes/claude test:direct-local"
  },
  "dependencies": {
    "@werft-ai/contracts": "workspace:*",
    "@werft-ai/observability": "workspace:*",
    "@werft-ai/runtime-claude": "workspace:*",
    "@werft-ai/runtime-core": "workspace:*",
    "@werft-ai/storage": "workspace:*",
    "@werft-ai/system": "workspace:*"
  },
  "devDependencies": {
    "@werft-ai/testkit": "workspace:*"
  }
}
