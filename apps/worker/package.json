{
  "name": "@agent-platform/worker",
  "description": "Kiel session runtime: one container per session running the Claude Agent SDK",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "bun run src/main.ts",
    "test:unit": "bun test src --path-ignore-patterns='**/*.integration.test.ts' && bun run --cwd ../../packages/adapters/runtimes/claude test:unit",
    "test:direct-local": "bun test .integration.test.ts && bun run --cwd ../../packages/adapters/runtimes/claude test:direct-local"
  },
  "dependencies": {
    "@agent-platform/contracts": "workspace:*",
    "@agent-platform/observability": "workspace:*",
    "@agent-platform/runtime-claude": "workspace:*",
    "@agent-platform/runtime-core": "workspace:*",
    "@agent-platform/storage": "workspace:*",
    "@agent-platform/system": "workspace:*"
  },
  "devDependencies": {
    "@agent-platform/testkit": "workspace:*"
  }
}
