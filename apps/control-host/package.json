{
  "name": "@werft-ai/control-host",
  "description": "Kiel session runtime: control host (api, scheduler and reconciler roles) serving the public /v1 API and the worker gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "bun --watch src/main.ts api",
    "start": "bun run src/main.ts api",
    "scheduler": "bun run src/main.ts scheduler --once",
    "reconciler": "bun run src/main.ts reconciler --once",
    "keys": "bun run src/api/keys.ts",
    "grants": "bun run src/api/grants.ts",
    "slack-install": "bun run src/api/slack-install.ts",
    "slack-app": "bun run src/api/slack-app.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "migrate-workspace": "bun run src/scheduler/migrate-workspace.ts"
  },
  "dependencies": {
    "@werft-ai/contracts": "workspace:*",
    "@werft-ai/db": "workspace:*",
    "@werft-ai/execution-kubernetes": "workspace:*",
    "@werft-ai/execution-local-docker": "workspace:*",
    "@werft-ai/observability": "workspace:*",
    "@werft-ai/platform": "workspace:*",
    "@werft-ai/runtime-claude-codec": "workspace:*",
    "@werft-ai/storage": "workspace:*",
    "@aws-sdk/client-secrets-manager": "^3.888.0",
    "@hono/zod-openapi": "1.6.3",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/request": "10.0.16",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.11",
    "pg": "8.16.3",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@scalar/api-reference": "1.72.1",
    "@werft-ai/testkit": "workspace:*",
    "@electric-sql/pglite": "0.3.10",
    "@types/pg": "8.15.5"
  }
}
