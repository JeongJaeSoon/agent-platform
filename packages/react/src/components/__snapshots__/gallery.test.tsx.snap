// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`도메인 컴포넌트 갤러리 360px 1`] = `
"<div class="gallery">
  <h2>StatusLabel</h2>
  <section>
    <h3>session</h3>
    <div class="gallery__row">
      <span class="ap-status" data-axis="session" data-state="queued" data-tone="neutral">
