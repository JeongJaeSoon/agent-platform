{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // No DOM lib: the modules leave the page to the host app. biome.json's
    // override for this package rejects the browser globals Bun's types
    // still declare. The blocks and components draw packages/ui and are
    // checked by tsconfig.blocks.json.
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/blocks/**", "src/components/**"]
}
