{
  "name": "@agent-platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./pool": "./src/pool.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "bun run scripts/generate-migration.ts",
    "db:migrate": "bun run src/migrate.ts",
    "db:restack": "bun run scripts/restack-migration.ts"
  },
  "dependencies": {
    "@agent-platform/contracts": "workspace:*",
    "@agent-platform/observability": "workspace:*",
    "@agent-platform/platform": "workspace:*",
    "@agent-platform/runtime-core": "workspace:*",
    "@agent-platform/system": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "pg-connection-string": "2.14.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "@agent-platform/testkit": "workspace:*"
  }
}
