{
  "name": "@werft-ai/db",
  "description": "Kiel session runtime: Drizzle schema, migrations and session queries",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./pool": "./src/pool.ts"
  },
  "scripts": {
    "bench:session-reads": "bun run bench/session-reads.ts",
    "bench:terminate": "bun run bench/terminate-control.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "bun run scripts/generate-migration.ts",
    "db:migrate": "bun run src/migrate.ts",
    "db:restack": "bun run scripts/restack-migration.ts"
  },
  "dependencies": {
    "@werft-ai/contracts": "workspace:*",
    "@werft-ai/observability": "workspace:*",
    "@werft-ai/platform": "workspace:*",
    "@werft-ai/system": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "pg-connection-string": "2.14.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "@werft-ai/testkit": "workspace:*"
  }
}
