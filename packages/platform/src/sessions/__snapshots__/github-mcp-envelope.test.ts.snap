      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean",
            },
            "result": {
              "additionalProperties": false,
              "properties": {
                "intent_refusal": {
                  "anyOf": [
                    {
                      "enum": [
                        "turn_ended_without_checkpoint",
                        "turn_finalized_without_pin",
                        "session_closed",
                        "rejected_before",
                        "request_open",
                        "github_disabled",
                        "over_workspace_ceiling",
                        "repository_not_allowed",
                        "checkpoint_unavailable",
                        "source_missing",
                        "attribution_mismatch",
                        "uncommitted_changes",
                        "pinned_source_invalid",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "intent_status": {
                  "anyOf": [
                    {
                      "enum": [
                        "deferred",
                        "pinned",
                        "requested",
                        "failed",
                        "cancelled",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "pull_request": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "number": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "url": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "number",
                        "url",
                      ],
                      "type": "object",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "pull_request_error": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "pull_request_scheduled": {
                  "type": "boolean",
                },
                "pull_request_stage": {
                  "anyOf": [
                    {
                      "enum": [
                        "due",
                        "opening",
                        "opened",
                        "closed_unrecorded",
                        "uncertain",
                        "failed",
                        "cancelled",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "push_intent_id": {
                  "anyOf": [
                    {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "push_request_id": {
                  "anyOf": [
                    {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "push_state": {
                  "anyOf": [
                    {
                      "enum": [
