                        "approved",
                        "rejected",
                        "pushing",
                        "pushed",
                        "failed",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "repository_id": {
                  "type": "string",
                },
                "target_branch": {
                  "type": "string",
                },
              },
              "required": [
                "push_intent_id",
                "intent_status",
                "intent_refusal",
                "push_request_id",
                "push_state",
                "repository_id",
                "target_branch",
