        },
      ],
      "type": "object",
    },
  },
  {
    "_meta": {
      "class": "repository.read",
    },
    "description": "List the repositories the session can work on, 100 a page. The session's own comes first on the first page and is not counted in \`limit\` (1 to 500); the others are in id order. \`next_cursor\` is non-null when more follow: send it back as \`cursor\`. \`query\` keeps those whose id or name contains it. \`status\` is \`primary\` (the session's own), \`attached\`, \`pending\` or \`failed\` (fetch in progress or failed), \`available\` (attach_repository would add it) or \`allowed_in_newer_release\` (only the agent's current release allows it).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_repositories",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean",
            },
            "result": {
              "additionalProperties": false,
              "properties": {
                "next_cursor": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "repositories": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "branch": {
                        "type": [
                          "string",
                          "null",
                        ],
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "name": {
                        "type": "string",
                      },
                      "status": {
                        "enum": [
                          "primary",
                          "attached",
                          "pending",
                          "failed",
                          "available",
                          "allowed_in_newer_release",
                        ],
                        "type": "string",
                      },
                    },
                    "required": [
                      "id",
                      "name",
                      "branch",
                      "status",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
              },
              "required": [
                "repositories",
                "next_cursor",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "result",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false,
              "type": "boolean",
            },
            "refusal": {
              "additionalProperties": false,
              "properties": {
                "by": {
                  "enum": [
                    "policy",
                    "person",
                    "platform",
                    "github",
                  ],
                  "type": "string",
                },
                "code": {
                  "pattern": "^[a-z][a-z0-9_]{1,63}$",
                  "type": "string",
                },
                "details": {
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
                "retryable": {
                  "type": "boolean",
                },
              },
              "required": [
                "code",
                "by",
                "retryable",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "refusal",
          ],
          "type": "object",
        },
      ],
      "type": "object",
    },
  },
  {
    "_meta": {
      "class": "repository.read",
    },
    "description": "Attach a repository the release allows to the session as a git remote named \`repository_id\`, with its default branch fetched to \`<repository_id>/<branch>\`. \`status\` is \`pending\` while the fetch runs. \`wait_seconds\` (0 to 7, default 0) holds the answer until the fetch ends or the seconds have passed; \`final\` is false when the fetch was still running at the end of the wait. Attaching an attached repository changes nothing. To change files in it, check out \`<repository_id>/<branch>\` as a branch in the workspace; a git worktree or clone elsewhere is not captured, and a push carries only the one commit the checked-out branch ends with, so push one repository per turn.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "wait_seconds": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "repository_id",
      ],
      "type": "object",
    },
    "name": "attach_repository",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean",
            },
            "result": {
              "additionalProperties": false,
              "properties": {
                "already_attached": {
                  "type": "boolean",
                },
                "branch": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "commit": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "failure": {
                  "anyOf": [
                    {
                      "enum": [
                        "fetch_timeout",
                        "fetch_too_large",
                        "fetch_failed",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "final": {
                  "type": "boolean",
                },
                "receipt_id": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "repository_id": {
                  "minLength": 1,
                  "type": "string",
                },
                "status": {
                  "enum": [
                    "pending",
                    "attached",
                    "failed",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "repository_id",
                "status",
                "branch",
                "commit",
                "failure",
                "already_attached",
                "receipt_id",
                "final",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "result",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false,
              "type": "boolean",
            },
            "refusal": {
              "additionalProperties": false,
              "properties": {
                "by": {
                  "enum": [
                    "policy",
                    "person",
                    "platform",
                    "github",
                  ],
                  "type": "string",
                },
                "code": {
                  "pattern": "^[a-z][a-z0-9_]{1,63}$",
                  "type": "string",
                },
                "details": {
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
                "retryable": {
                  "type": "boolean",
                },
              },
              "required": [
                "code",
