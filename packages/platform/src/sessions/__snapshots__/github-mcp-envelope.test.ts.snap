  {
    "_meta": {
      "class": "push",
    },
    "description": "Read where one push stands: the intent (\`intent_status\`, \`intent_refusal\`), the push request (\`push_state\`) and its pull request stage (\`pull_request_stage\`, \`pull_request_error\`, \`pull_request\`). Give \`push_request_id\` or \`push_intent_id\`, never both; both ids answer the same push once the intent became a push request.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "push_intent_id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "push_request_id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "get_push_request",
