  {
    "_meta": {
      "class": "pull_request.write",
    },
    "description": "Set the title or the content of the pull request that the push request's branch has open. Given any of \`summary\`, \`changes\`, \`rationale\`, \`testing\`, \`notes\` or \`related\`, the body is written again from those fields (a field left out is empty); \`body\` (legacy) replaces the body as text; \`title\` alone leaves the body. The platform's closing lines stay, naming the push request's commit.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 60000,
          "type": "string",
        },
        "changes": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "notes": {
          "maxLength": 8000,
          "type": "string",
        },
        "push_request_id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "rationale": {
          "maxLength": 8000,
          "type": "string",
        },
        "related": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "closes": {
                "type": "boolean",
              },
              "number": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "repository_id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "number",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
        "summary": {
          "maxLength": 8000,
          "type": "string",
        },
        "testing": {
          "maxLength": 8000,
          "type": "string",
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "push_request_id",
      ],
      "type": "object",
    },
