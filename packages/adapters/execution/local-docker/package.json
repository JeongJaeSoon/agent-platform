{
  "name": "@agent-platform/execution-local-docker",
  "description": "Kiel session runtime: local Docker execution backend for worker containers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test src --path-ignore-patterns='**/*.integration.test.ts'",
    "test:docker": "DOCKER_BACKEND_TEST=1 bun test .integration.test.ts"
  },
  "dependencies": {
    "@agent-platform/contracts": "workspace:*",
    "@agent-platform/platform": "workspace:*"
  },
  "devDependencies": {
    "@agent-platform/testkit": "workspace:*"
  }
}
